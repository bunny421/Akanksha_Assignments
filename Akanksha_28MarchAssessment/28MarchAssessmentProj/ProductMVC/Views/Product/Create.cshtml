@model ProductMVC.Models.Product

<h2>Add Product</h2>

<form method="post">
    <label>Name:</label>
    <input type="text" asp-for="Name" /><br />

    <label>Price:</label>
    <input type="number" asp-for="Price" /><br />

    <label>Category:</label>
    <input type="text" asp-for="Category" /><br />

    <button type="submit">Save</button>
</form>